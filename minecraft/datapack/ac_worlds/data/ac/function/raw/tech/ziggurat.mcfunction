tellraw @a {"text": "Technology: Ziggurats and fired brick", "color": "gold", "bold": true}
tellraw @a {"text": "Ur-type ziggurat: fired-brick skin, weep holes, triple stair and shrine.", "color": "white"}
tellraw @a {"text": "Sumer, Babylon, Ur ziggurat c. 2100 BCE", "color": "yellow"}
tellraw @a {"text": "Stepped temple platforms of sun-dried mud brick cased in kiln-fired brick set in bitumen,", "color": "gray"}
tellraw @a {"text": "with weep holes to drain the core. The Ur ziggurat's lowest stage measured 64 by 46", "color": "gray"}
tellraw @a {"text": "metres.", "color": "gray"}
tellraw @a {"text": "Sun-dried brick is cheap but dissolves in rain; a skin of fired brick bonded with bitumen", "color": "gray"}
tellraw @a {"text": "(from natural seeps) sealed the outside. Reed mats and ropes laid between courses stopped", "color": "gray"}
tellraw @a {"text": "the core from slumping. Three converging stairs led to the shrine on top.", "color": "gray"}
