tellraw @a {"text": "Raised lake fields with wattle fences, willows, canals and a canoe.", "color": "white"}
tellraw @a {"text": "Aztec (Mexica), 14th-16th centuries", "color": "yellow"}
tellraw @a {"text": "Raised fields built in the shallow lake from layers of mud and vegetation held by wattle", "color": "gray"}
tellraw @a {"text": "fences and willow roots, giving up to seven harvests a year from a few metres of width.", "color": "gray"}
tellraw @a {"text": "Tenochtitlan's 200,000 people depended on them.", "color": "gray"}
tellraw @a {"text": "A rectangle is staked out in the lake, fenced with wattle, and filled with alternating", "color": "gray"}
tellraw @a {"text": "layers of lake mud and decaying plants; willows planted at the edges root through and", "color": "gray"}
tellraw @a {"text": "anchor it. Canals between the plots serve for transport and irrigation by hand; dredged", "color": "gray"}
tellraw @a {"text": "canal mud renews the soil.", "color": "gray"}
