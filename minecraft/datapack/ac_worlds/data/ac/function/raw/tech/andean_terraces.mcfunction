tellraw @a {"text": "Technology: Andean terraces (andenes) and Moray", "color": "gold", "bold": true}
tellraw @a {"text": "Moray-style concentric terraced bowl with irrigation channel.", "color": "white"}
tellraw @a {"text": "Inca and earlier Andean cultures, pre-Inca to 1530s", "color": "yellow"}
tellraw @a {"text": "Stepped stone-walled terraces turned slopes into level fields with deep soil and drainage,", "color": "gray"}
tellraw @a {"text": "and created micro-climates; Moray's concentric terraced bowls differ by 15 degrees C from", "color": "gray"}
tellraw @a {"text": "top to bottom and may have been an agricultural laboratory.", "color": "gray"}
tellraw @a {"text": "Each terrace has a stone retaining wall, a base layer of rubble for drainage, gravel, then", "color": "gray"}
tellraw @a {"text": "imported topsoil; stone steps (sarunas) protrude from the walls. Channels from springs", "color": "gray"}
tellraw @a {"text": "irrigate from the top down; the stone stores daytime heat against frost.", "color": "gray"}
tellraw @a {"text": "See it in context: /function ac:japan/iga", "color": "aqua"}
