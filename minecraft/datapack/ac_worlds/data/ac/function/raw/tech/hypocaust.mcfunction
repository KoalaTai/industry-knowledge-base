tellraw @a {"text": "Technology: Hypocaust heating and the public bath", "color": "gold", "bold": true}
tellraw @a {"text": "Bath cut-away: furnace, pilae, box-tile walls, plunge, roof flues.", "color": "white"}
tellraw @a {"text": "Rome, 1st century BCE onward", "color": "yellow"}
tellraw @a {"text": "Underfloor heating: the floor sits on short brick piers, and hot gases from a furnace", "color": "gray"}
tellraw @a {"text": "(praefurnium) circulate beneath it and up through hollow box tiles (tubuli) in the walls", "color": "gray"}
tellraw @a {"text": "before leaving by flues in the roof.", "color": "gray"}
tellraw @a {"text": "Slaves stoked a wood furnace at one end; the floor of the hot room (caldarium) nearest the", "color": "gray"}
tellraw @a {"text": "furnace reached 50 degrees C and bathers wore sandals. Rooms were sequenced warm to hot to", "color": "gray"}
tellraw @a {"text": "cold (tepidarium, caldarium, frigidarium) and water was heated in bronze boilers over the", "color": "gray"}
tellraw @a {"text": "same fire.", "color": "gray"}
