tellraw @a {"text": "Technology: Stepwells (baori, vav)", "color": "gold", "bold": true}
tellraw @a {"text": "Chand Baori type stepwell, 12 storeys down to the water.", "color": "white"}
tellraw @a {"text": "India (Rajasthan and Gujarat), Chand Baori c. 800-900 CE; Rani ki Vav 1063", "color": "yellow"}
tellraw @a {"text": "Monumental wells with flights of steps descending many storeys to the water table, so that", "color": "gray"}
tellraw @a {"text": "water could be reached whatever the season and the shaded lower levels stayed cool.", "color": "gray"}
tellraw @a {"text": "Chand Baori drops 13 storeys (about 30 metres) with 3,500 steps on three sides, the fourth", "color": "gray"}
tellraw @a {"text": "side holding a pavilion. The stone walls retain the sand and the deep shaft limits", "color": "gray"}
tellraw @a {"text": "evaporation; monsoon rain refills it.", "color": "gray"}
tellraw @a {"text": "See it in context: /function ac:chronicles/amritsar", "color": "aqua"}
