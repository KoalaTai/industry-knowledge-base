tellraw @a {"text": "Technology: Mesoamerican pyramids and Maya astronomy", "color": "gold", "bold": true}
tellraw @a {"text": "Nine-tier pyramid with four stairways and serpent heads.", "color": "white"}
tellraw @a {"text": "Teotihuacan, Maya, Aztec, c. 100 BCE to 1500 CE", "color": "yellow"}
tellraw @a {"text": "Stepped platforms of rubble and adobe faced with cut stone and lime plaster, often", "color": "gray"}
tellraw @a {"text": "enlarged by building a new pyramid over the old. Alignments and stairways encode", "color": "gray"}
tellraw @a {"text": "calendars: El Castillo at Chichen Itza has 365 steps and casts a serpent shadow at the", "color": "gray"}
tellraw @a {"text": "equinoxes.", "color": "gray"}
tellraw @a {"text": "No metal tools, draft animals or wheels: stone was cut with harder stone, carried by", "color": "gray"}
tellraw @a {"text": "tumpline, and bonded with lime plaster burned from limestone, which consumed forests. The", "color": "gray"}
tellraw @a {"text": "Maya Long Count and their eclipse tables (Dresden Codex) came from naked-eye observation", "color": "gray"}
tellraw @a {"text": "over centuries.", "color": "gray"}
