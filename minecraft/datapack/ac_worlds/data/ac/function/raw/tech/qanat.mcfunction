tellraw @a {"text": "Technology: Qanat", "color": "gold", "bold": true}
tellraw @a {"text": "Cut-away hillside showing mother well, shafts, graded tunnel and outlet fields.", "color": "white"}
tellraw @a {"text": "Persia (Achaemenid and earlier), first millennium BCE", "color": "yellow"}
tellraw @a {"text": "A gently sloping underground tunnel that taps an aquifer at the foot of the mountains and", "color": "gray"}
tellraw @a {"text": "carries water by gravity for kilometres to fields and towns, without pumps and with almost", "color": "gray"}
tellraw @a {"text": "no evaporation.", "color": "gray"}
tellraw @a {"text": "Surveyors sink a mother well to find the water table, then dig a line of vertical shafts", "color": "gray"}
tellraw @a {"text": "every 20 to 30 metres for spoil removal and ventilation; the tunnel is driven between them", "color": "gray"}
tellraw @a {"text": "on a gradient of about 1 in 1000. The water surfaces where the tunnel meets the ground.", "color": "gray"}
